{
  "name": "whatsapp-auth-boilerplate",
  "version": "1.0.0",
  "description": "WhatsApp-First Authentication Boilerplate powered by Minimoth, Express, and React",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -k -n \"api,app\" -c \"cyan,green\" \"python server.py\" \"npm run client\"",
    "dev:node": "concurrently -k -n \"api,app\" -c \"cyan,green\" \"node server.js\" \"npm run client\"",
    "client": "vite",
    "server": "python server.py",
    "server:node": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "python server.py",
    "start:node": "node server.js"
  },
  "keywords": [
    "minimoth",
    "whatsapp",
    "otp",
    "authentication",
    "hackathon",
    "express",
    "react",
    "vite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@minimoth/sdk-node": "^0.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "vite": "^8.3.3"
  }
}
